{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "height": 900,
        "minHeight": 520,
        "minWidth": 720,
        "title": "StreamFlow Lite",
        "width": 1440,
        "theme": "Dark"
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "publisher": "Soft Trump (Syed Sibt)",
    "copyright": "\u00a9 2026 Soft Trump (Syed Sibt)"
  },
  "identifier": "com.streamflow.lite",
  "productName": "StreamFlow Lite",
  "version": "0.1.26"
}
